[Unit]
Description=Churchill biodiversity FastAPI production service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=churchill
Group=churchill
WorkingDirectory=/srv/churchill/current
EnvironmentFile=/etc/churchill/production.env
ExecStart=/srv/churchill/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/churchill
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
